@using SPU.Lib.FraudDetection.DTO.ReportTemplate
@model IList<SuspiciousCustormer>

<h3>Suspicious Statistic</h3>
    <table style="border: 1px solid black; padding: 3px; border-collapse: collapse;">
        <tr>
            <th style="border: 1px solid black; padding: 3px; background-color: #bbb;">Member</th>
            <th style="border: 1px solid black; padding: 3px; background-color: #bbb;">Worflow</th>
            <th style="border: 1px solid black; padding: 3px; background-color: #bbb;">Sport</th>
            <th style="border: 1px solid black; padding: 3px; background-color: #bbb;">League</th>
            <th style="border: 1px solid black; padding: 3px; background-color: #bbb;">MatchId</th>
            <th style="border: 1px solid black; padding: 3px; background-color: #bbb;">Match Code</th>
            <th style="border: 1px solid black; padding: 3px; background-color: #bbb;">Event Date</th>
            <th style="border: 1px solid black; padding: 3px; background-color: #bbb;">Event</th>
        </tr>
@if (Model.Any())
{
    foreach (var customer in Model)
     {
         <tr>
             <td style="border: 1px solid black; padding: 3px;">@customer.Member</td>
             <td style="border: 1px solid black; padding: 3px;">@customer.Workflow</td>
             <td style="border: 1px solid black; padding: 3px;">@customer.Sport</td>
             <td style="border: 1px solid black; padding: 3px;">@customer.League</td>
             <td style="border: 1px solid black; padding: 3px;">@customer.MatchId</td>
             <td style="border: 1px solid black; padding: 3px;">@customer.MatchCode</td>
             <td style="border: 1px solid black; padding: 3px;">@customer.EventDate</td>
             <td style="border: 1px solid black; padding: 3px;">@customer.Event</td>
         </tr>
     }
}
else
{
        <tr>
            <td colspan="8" style="text-align: center; padding: 3px;">No data is available.</td>
        </tr>
}
    </table>