@using SPU.Lib.FraudDetection.DTO.ReportTemplate
@model IList<MarginCustormer>

@{
    const int TwoPreviousMonths = 2;
}
<h3>Margin %</h3>
<table style="border: 1px solid black; border-collapse: collapse; padding: 3px;">
    <tr>
        <th style="background-color: #bbb; border: 1px solid black; padding: 3px;">Member</th>
        @for (var i = TwoPreviousMonths; i >= 0; i--)
        {
            <th style="background-color: #bbb; border: 1px solid black; padding: 3px;">@DateTime.Now.AddMonths(-i).ToString("MMM")</th>
        }
    </tr>
    @if (Model.Any())
    {
        foreach (var customer in Model)
        {
            <tr>
                <td style="border: 1px solid black; padding: 3px;">@customer.Member</td>
                @foreach (var margin in customer.Margins)
                {
                    <td style="border: 1px solid black; padding: 3px; text-align: right;">
                        @(margin.HasValue ? string.Format("{0:P2}", margin.Value) : "N/A")
                    </td>
                }
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="4" style="padding: 3px; text-align: center;">No data is available.</td>
        </tr>
    }
</table>